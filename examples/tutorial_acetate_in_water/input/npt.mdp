; NPT equilibration
; Generated by MoleditPy GROMACS Input Generator 0.1.0
integrator              = md
nsteps                  = 50000             ; 0.1 ns
dt                      = 0.002             ; ps
; Output
nstxout-compressed      = 5000              ; xtc frames
nstenergy               = 1000
nstlog                  = 1000
nstcalcenergy           = 100
; Neighbour searching and non-bonded interactions
cutoff-scheme           = Verlet
nstlist                 = 10                ; Verlet buffer adjusts this automatically
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1                 ; nm
vdwtype                 = Cut-off
vdw-modifier            = Potential-shift
rvdw                    = 1                 ; nm
fourierspacing          = 0.12              ; nm
pme-order               = 4
DispCorr                = EnerPres          ; long-range dispersion correction
; Bonds
constraints             = h-bonds
constraint-algorithm    = lincs
lincs-order             = 4
lincs-iter              = 1
; Temperature coupling
tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 0.1               ; ps
ref-t                   = 300               ; K
; Pressure coupling
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau-p                   = 2                 ; ps
ref-p                   = 1                 ; bar
compressibility         = 4.5e-05           ; 1/bar (water)
refcoord-scaling        = com
; Velocities
continuation            = yes               ; continue from the previous stage
gen-vel                 = no
