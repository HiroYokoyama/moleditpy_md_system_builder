; Energy minimisation
; Generated by MoleditPy GROMACS Input Generator 0.1.0
integrator              = steep
nsteps                  = 50000             ; maximum number of minimisation steps
emtol                   = 1000              ; kJ/mol/nm, stop when Fmax < emtol
emstep                  = 0.01              ; nm, initial step size
nstenergy               = 500
nstlog                  = 500
; Neighbour searching and non-bonded interactions
cutoff-scheme           = Verlet
nstlist                 = 10                ; Verlet buffer adjusts this automatically
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1                 ; nm
vdwtype                 = Cut-off
vdw-modifier            = Potential-shift
rvdw                    = 1                 ; nm
fourierspacing          = 0.12              ; nm
pme-order               = 4
DispCorr                = EnerPres          ; long-range dispersion correction
constraints             = none              ; unconstrained minimisation
